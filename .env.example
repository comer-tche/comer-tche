# Copie este arquivo para .env antes de subir a aplicacao.
# O .env real nunca deve ser versionado: ele esta no .gitignore, e a condicao
# C2 do pipeline (secao 20.3 do trabalho) interrompe a entrega se um segredo
# aparecer no repositorio.

# Banco de dados de desenvolvimento (SQLite, arquivo local).
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar os tokens de sessao.
# Gere o seu com: openssl rand -base64 32
JWT_SECRET="troque-por-um-valor-aleatorio-de-pelo-menos-32-bytes"

# Segredo compartilhado com o gateway de pagamento, usado para validar a
# assinatura das confirmacoes (requisito RS04).
# Gere o seu com: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET="troque-por-um-valor-aleatorio"
