// Modelo de dados do Comer-Tche.
//
// ATENCAO: nesta versao inicial os identificadores expostos pela API sao
// numeros sequenciais (autoincrement). Isso e proposital: o risco R07 do
// trabalho descreve exatamente esse problema, e a Decisao 3 da Etapa 3 troca
// esses identificadores por UUID em um commit posterior.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  nome         String
  telefone     String
  endereco     String
  // Perfis possiveis: CLIENTE, ENTREGADOR, RESTAURANTE, ADMIN
  perfil       String   @default("CLIENTE")
  criadoEm     DateTime @default(now())

  pedidos Order[]
}

model MenuItem {
  name       String
  id         Int     @id @default(autoincrement())
  descricao  String
  precoEmCentavos Int
  disponivel Boolean @default(true)

  itensDePedido OrderItem[]
}

model Order {
  id                 Int      @id @default(autoincrement())
  clienteId          Int
  cliente            User     @relation(fields: [clienteId], references: [id])
  totalEmCentavos    Int
  // Estados possiveis: AGUARDANDO_PAGAMENTO, PAGO, EM_PREPARO, ENTREGUE, CANCELADO
  situacao           String   @default("AGUARDANDO_PAGAMENTO")
  enderecoDeEntrega  String
  criadoEm           DateTime @default(now())

  itens    OrderItem[]
  pagamento Payment?
}

model OrderItem {
  id                   Int      @id @default(autoincrement())
  pedidoId             Int
  pedido               Order    @relation(fields: [pedidoId], references: [id])
  itemDoCardapioId     Int
  itemDoCardapio       MenuItem @relation(fields: [itemDoCardapioId], references: [id])
  quantidade           Int
  precoUnitarioEmCentavos Int
}

model Payment {
  id              Int      @id @default(autoincrement())
  pedidoId        Int      @unique
  pedido          Order    @relation(fields: [pedidoId], references: [id])
  // Estados possiveis: PENDENTE, CONFIRMADO, RECUSADO
  situacao        String   @default("PENDENTE")
  valorEmCentavos Int
  criadoEm        DateTime @default(now())
}

// Trilha de auditoria. Passo 1 da ordem de implementacao (secao 9.5 do
// trabalho) e controle do risco R06: sem registro confiavel, nenhum outro
// risco pode ser detectado, investigado ou comprovado.
//
// O modelo so recebe insercao. Nao existe rota que altere nem apague
// registro, e o proprio acesso a trilha tambem e registrado.
model AuditLog {
  id          Int      @id @default(autoincrement())
  // Quem executou. Fica nulo quando a acao foi anonima, como uma tentativa
  // de login com e-mail inexistente.
  autorId     Int?
  autorPerfil String?
  // O que aconteceu, em maiusculas: LOGIN_NEGADO, ACESSO_NEGADO_PERFIL, etc.
  acao        String
  // Sobre qual recurso, quando aplicavel: "pedido:42", "usuario:7".
  alvo        String?
  rota        String
  origemIp    String?
  agente      String?
  // Detalhe adicional em texto. Nunca recebe senha, token ou dado de cartao.
  detalhe     String?
  criadoEm    DateTime @default(now())

  @@index([autorId])
  @@index([acao])
}

// Dispositivos ja reconhecidos para um usuario. Requisito RS03: o segundo
// fator so e exigido quando o login vem de um aparelho que nunca foi visto,
// para nao atrapalhar o uso normal.
model KnownDevice {
  id         Int      @id @default(autoincrement())
  usuarioId  Int
  // Guardamos o hash da impressao do dispositivo, e nao a impressao em si:
  // se o banco vazar, ela nao serve para rastrear ninguem.
  impressao  String
  primeiroUso DateTime @default(now())
  ultimoUso   DateTime @default(now())

  @@unique([usuarioId, impressao])
}

// Desafio de segundo fator pendente. Vive poucos minutos e e apagado assim
// que usado.
model MfaChallenge {
  id         String   @id
  usuarioId  Int
  // O codigo tambem e guardado como hash: quem ler o banco nao consegue
  // completar o login de ninguem.
  codigoHash String
  impressao  String
  tentativas Int      @default(0)
  expiraEm   DateTime
  criadoEm   DateTime @default(now())
}
